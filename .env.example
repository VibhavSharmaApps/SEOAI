# Example environment variables
# IMPORTANT: Copy to apps/web/.env.local and fill in your actual values
# NEVER commit .env.local or any file containing real API keys!

# ============================================
# Supabase Configuration
# ============================================
# Get these from: https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ============================================
# Database Configuration
# ============================================
# Use the pooled connection string from Supabase
# Get from: https://app.supabase.com/project/_/settings/database
DATABASE_URL="postgresql://postgres.xxxxx:password@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres"

# ============================================
# AI Provider API Keys
# ============================================
# OpenAI - Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# Anthropic (Claude) - Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# ============================================
# Application Settings
# ============================================
# For development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# For production (set in Vercel)
# NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app
# NODE_ENV=production

# ============================================
# DataForSEO API Credentials (Optional)
# ============================================
# Get from: https://app.dataforseo.com/api-dashboard
DATAFORSEO_LOGIN=your_dataforseo_login@example.com
DATAFORSEO_PASSWORD=your_dataforseo_password

# ============================================
# Optional: Vercel Analytics (if using)
# ============================================
# NEXT_PUBLIC_VERCEL_ANALYTICS_ID=your_analytics_id

# ============================================
# Optional: Sentry Error Tracking (if using)
# ============================================
# SENTRY_DSN=your_sentry_dsn
# SENTRY_AUTH_TOKEN=your_sentry_auth_token

# ============================================
# Optional: Redis/Upstash for Rate Limiting (if using)
# ============================================
# UPSTASH_REDIS_REST_URL=your_redis_url
# UPSTASH_REDIS_REST_TOKEN=your_redis_token
